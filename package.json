{
  "name": "s3-explorer",
  "version": "3.0.0",
  "description": "A secure, self-hosted web-based file manager for S3-compatible storage buckets",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "pnpm --filter s3-explorer-server dev",
    "dev:client": "pnpm --filter s3-explorer-client dev",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "pnpm --filter s3-explorer-client build",
    "build:server": "pnpm --filter s3-explorer-server build",
    "start": "pnpm --filter s3-explorer-server start",
    "typecheck": "pnpm -r typecheck",
    "check:biome": "biome check .",
    "biome:fix": "biome check --write .",
    "db": "pnpm --filter s3-explorer-server db",
    "db:info": "pnpm --filter s3-explorer-server db:info",
    "db:sql": "pnpm --filter s3-explorer-server db:sql",
    "db:backup": "pnpm --filter s3-explorer-server db:backup",
    "db:reset": "pnpm --filter s3-explorer-server db:reset",
    "db:nuke": "pnpm --filter s3-explorer-server db:nuke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
